# 모든 DB 접근이 HTTPS(443)로 나간다. Postgres 직결(5432)은 쓰지 않으므로,
# 5432를 막는 네트워크(회사망·일부 ISP)에서도 그대로 동작한다.
#
# 이미 쓰고 있는 Supabase 프로젝트를 재사용해도 된다 — 테이블은 전부
# `tierboard` 스키마 안에 만들어져 기존 public 스키마와 충돌하지 않는다.

# ── 필수 ────────────────────────────────────────────────────────────────────
# Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# 브라우저 실시간 구독용. 읽기 전용이고 프론트엔드 번들에 그대로 노출되는
# 공개 값이라 커밋돼도 위험하지 않다. 예전 프로젝트는 anon key를 써도 된다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 수집·시드·번역이 쓰는 서버 전용 키. 비밀 값이므로 NEXT_PUBLIC_ 금지.
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (예전 형식도 지원)

# ── 선택: 스키마 자동 적용 ───────────────────────────────────────────────────
# npm run db:push 에만 쓰인다. 없으면 supabase/schema.sql을 SQL 편집기에 붙여넣으면 된다.
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...

# ── 한국어 번역 ─────────────────────────────────────────────────────────────
# 기본 엔진은 MyMemory — 무료, 키 불필요. 이메일을 넣으면 일일 한도가
# 5,000 → 50,000자로 늘어난다 (헤드라인 ~70자 기준 하루 70건 → 700건).
MYMEMORY_EMAIL=you@example.com

# 넣으면 MyMemory 대신 Claude를 쓴다. 축구 고유명사·국내 통용 표기가 훨씬
# 정확하지만 이 물량에 월 $3 정도 든다.
# ANTHROPIC_API_KEY=sk-ant-...
# TRANSLATE_MODEL=claude-opus-4-8

# ── 선택: 브라우저를 닫아도 오는 알림 ─────────────────────────────────────────
# NOTIFY_TEAMS=liverpool,arsenal
# NOTIFY_MAX_TIER=1
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── 선택: 팀 엠블럼 (npm run crests) ─────────────────────────────────────────
# 무료 발급: https://www.football-data.org/client/register
# FOOTBALL_DATA_TOKEN=
